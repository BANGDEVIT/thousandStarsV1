<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Helvetica Neue', Arial, sans-serif; background: #F7F7F5; }
    .wrapper { padding: 32px 16px; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #1B3A5C 0%, #0F2440 100%); padding: 40px; text-align: center; }
    .header .emoji { font-size: 48px; display: block; margin-bottom: 12px; }
    .header h1 { color: #C9A84C; font-size: 24px; font-weight: 600; margin-bottom: 6px; }
    .header p { color: rgba(255,255,255,0.75); font-size: 14px; }
    .countdown { background: #C9A84C; padding: 20px; text-align: center; }
    .countdown p { color: #1B3A5C; font-size: 13px; font-weight: 500; margin-bottom: 4px; }
    .countdown h2 { color: #1B3A5C; font-size: 28px; font-weight: 800; }
    .body { padding: 36px 40px; }
    .greeting { font-size: 16px; color: #0A0A0A; margin-bottom: 16px; }
    .text { font-size: 14px; color: #64748B; line-height: 1.7; margin-bottom: 20px; }
    .card { background: #F7F7F5; border-radius: 10px; padding: 20px 24px; margin-bottom: 16px; }
    .card h3 { font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px; }
    .row { display: flex; justify-content: space-between; margin-bottom: 10px; }
    .row:last-child { margin-bottom: 0; }
    .label { font-size: 13px; color: #64748B; }
    .value { font-size: 13px; color: #0A0A0A; font-weight: 500; }
    .room-item { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #E2E2D8; border-radius: 8px; padding: 12px 16px; margin-bottom: 8px; }
    .room-item:last-child { margin-bottom: 0; }
    .room-icon { font-size: 20px; }
    .room-num { font-size: 14px; font-weight: 600; color: #1B3A5C; }
    .room-type-text { font-size: 12px; color: #64748B; }
    .checklist { margin: 4px 0; }
    .check-item { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; font-size: 13px; color: #64748B; line-height: 1.5; }
    .check-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
    .map-btn { display: block; background: #1B3A5C; color: #fff; padding: 14px; border-radius: 8px; text-align: center; text-decoration: none; font-size: 14px; font-weight: 500; margin-top: 16px; }
    .gold { color: #C9A84C; font-weight: 600; }
    .footer { background: #F0F0EA; padding: 24px 40px; text-align: center; }
    .footer p { font-size: 12px; color: #64748B; line-height: 1.7; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">
    <!-- Header -->
    <div class="header">
      <span class="emoji">🌅</span>
      <h1>Ngày mai bạn check-in rồi!</h1>
      <p>Chúng tôi rất mong được đón tiếp bạn</p>
    </div>

    <!-- Countdown -->
    <div class="countdown">
      <p>Chỉ còn</p>
      <h2>1 ngày nữa ✈️</h2>
    </div>

    <!-- Body -->
    <div class="body">
      <p class="greeting">Xin chào <strong>{{customerName}}</strong>,</p>
      <p class="text">
        Đây là nhắc nhở thân thiện rằng ngày mai bạn sẽ check-in tại
        <strong>{{hotelName}}</strong>. Chúng tôi đã sẵn sàng chào đón bạn!
      </p>

      <!-- Booking Info -->
      <div class="card">
        <h3>Thông tin check-in</h3>
        <div class="row">
          <span class="label">Mã booking</span>
          <span class="value gold">#{{bookingId}}</span>
        </div>
        <div class="row">
          <span class="label">Ngày check-in</span>
          <span class="value">📅 {{checkInDate}}</span>
        </div>
        <div class="row">
          <span class="label">Giờ check-in</span>
          <span class="value">⏰ Từ {{checkInTime}}</span>
        </div>
      </div>

      <!-- Rooms -->
      <div class="card">
        <h3>Phòng của bạn</h3>
        {{#each rooms}}
        <div class="room-item">
          <span class="room-icon">🚪</span>
          <div>
            <p class="room-num">Phòng {{roomNumber}}</p>
            <p class="room-type-text">{{roomType}}</p>
          </div>
        </div>
        {{/each}}
      </div>

      <!-- Checklist -->
      <div class="card">
        <h3>Chuẩn bị trước khi đến</h3>
        <div class="checklist">
          <div class="check-item"><span class="check-icon">🪪</span><span>CMND/CCCD hoặc Hộ chiếu còn hiệu lực</span></div>
          <div class="check-item"><span class="check-icon">📱</span><span>Email xác nhận booking (email này)</span></div>
          <div class="check-item"><span class="check-icon">💳</span><span>Thẻ thanh toán nếu chưa thanh toán trước</span></div>
          <div class="check-item"><span class="check-icon">🅿️</span><span>Bãi đỗ xe miễn phí — báo trước nếu cần hỗ trợ</span></div>
        </div>
      </div>

      <!-- Location -->
      <div class="card">
        <h3>Địa chỉ khách sạn</h3>
        <div class="row">
          <span class="label">📍 Địa chỉ</span>
          <span class="value">{{hotelAddress}}</span>
        </div>
        <div class="row">
          <span class="label">☎ Hotline</span>
          <span class="value">{{hotelPhone}}</span>
        </div>
        <a href="{{mapUrl}}" class="map-btn">🗺️ Xem bản đồ →</a>
      </div>
    </div>

    <div class="footer">
      <p><strong>{{hotelName}}</strong></p>
      <p>{{hotelAddress}} | ☎ {{hotelPhone}}</p>
      <p>© {{currentYear}} {{hotelName}}. All rights reserved.</p>
    </div>
  </div>
</div>
</body>
</html>