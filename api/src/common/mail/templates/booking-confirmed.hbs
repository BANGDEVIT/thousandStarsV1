<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Helvetica Neue', Arial, sans-serif; background: #F7F7F5; }
    .wrapper { padding: 32px 16px; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .header { background: #1B3A5C; padding: 32px 40px; text-align: center; }
    .header h1 { color: #C9A84C; font-size: 22px; font-weight: 600; margin-bottom: 6px; }
    .header p { color: rgba(255,255,255,0.7); font-size: 14px; }
    .body { padding: 36px 40px; }
    .greeting { font-size: 16px; color: #0A0A0A; margin-bottom: 16px; }
    .badge-confirmed { display: inline-block; background: #D1FAE5; color: #065F46; padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600; margin-bottom: 20px; }
    .card { background: #F7F7F5; border-radius: 10px; padding: 20px 24px; margin-bottom: 16px; }
    .card h3 { font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px; }
    .row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
    .row:last-child { margin-bottom: 0; }
    .label { font-size: 13px; color: #64748B; flex-shrink: 0; }
    .value { font-size: 13px; color: #0A0A0A; font-weight: 500; text-align: right; }
    .divider { border: none; border-top: 1px solid #E2E2D8; margin: 14px 0; }
    .total-row { display: flex; justify-content: space-between; }
    .total-label { font-size: 15px; font-weight: 700; color: #0A0A0A; }
    .total-value { font-size: 18px; font-weight: 700; color: #1B3A5C; }
    .room-item { background: #fff; border: 1px solid #E2E2D8; border-radius: 8px; padding: 14px 16px; margin-bottom: 8px; }
    .room-item:last-child { margin-bottom: 0; }
    .room-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .room-number { font-size: 14px; font-weight: 600; color: #1B3A5C; }
    .room-type { font-size: 12px; color: #64748B; background: #F0F0EA; padding: 2px 8px; border-radius: 12px; }
    .room-price { font-size: 13px; color: #C9A84C; font-weight: 600; }
    .hotel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .hotel-item { background: #fff; border: 1px solid #E2E2D8; border-radius: 8px; padding: 12px 14px; }
    .hotel-item-label { font-size: 11px; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
    .hotel-item-value { font-size: 13px; color: #0A0A0A; font-weight: 500; }
    .special-req { background: #FEF3C7; border-radius: 8px; padding: 12px 16px; }
    .special-req p { font-size: 13px; color: #B45309; }
    .tips { margin-top: 4px; }
    .tip { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; font-size: 13px; color: #64748B; line-height: 1.5; }
    .gold { color: #C9A84C; font-weight: 600; }
    .footer { background: #F0F0EA; padding: 24px 40px; text-align: center; }
    .footer p { font-size: 12px; color: #64748B; line-height: 1.7; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="container">
    <div class="header">
      <h1>🏨 {{hotelName}}</h1>
      <p>Xác nhận đặt phòng thành công</p>
    </div>
    <div class="body">
      <p class="greeting">Xin chào <strong>{{customerName}}</strong>,</p>
      <span class="badge-confirmed">✅ Booking đã được xác nhận</span>

      <!-- Booking Info -->
      <div class="card">
        <h3>Thông tin đặt phòng</h3>
        <div class="row">
          <span class="label">Mã booking</span>
          <span class="value gold">#{{bookingId}}</span>
        </div>
        <div class="row">
          <span class="label">Check-in</span>
          <span class="value">📅 {{checkInDate}} (từ 14:00)</span>
        </div>
        <div class="row">
          <span class="label">Check-out</span>
          <span class="value">📅 {{checkOutDate}} (trước 12:00)</span>
        </div>
        <div class="row">
          <span class="label">Số đêm</span>
          <span class="value">🌙 {{nights}} đêm</span>
        </div>
        {{#if specialRequests}}
        <hr class="divider">
        <div class="special-req">
          <p>📝 Yêu cầu đặc biệt: <strong>{{specialRequests}}</strong></p>
        </div>
        {{/if}}
      </div>

      <!-- Rooms -->
      <div class="card">
        <h3>Phòng đã đặt</h3>
        {{#each rooms}}
        <div class="room-item">
          <div class="room-header">
            <span class="room-number">🚪 Phòng {{roomNumber}}</span>
            <span class="room-type">{{roomType}}</span>
          </div>
          <p class="room-price">{{pricePerNight}} đ / đêm</p>
        </div>
        {{/each}}
        <hr class="divider">
        <div class="total-row">
          <span class="total-label">Tổng tiền phòng</span>
          <span class="total-value gold">{{totalAmount}} đ</span>
        </div>
      </div>

      <!-- Hotel Info -->
      <div class="card">
        <h3>Thông tin khách sạn</h3>
        <div class="hotel-grid">
          <div class="hotel-item">
            <p class="hotel-item-label">📍 Địa chỉ</p>
            <p class="hotel-item-value">{{hotelAddress}}</p>
          </div>
          <div class="hotel-item">
            <p class="hotel-item-label">☎ Hotline</p>
            <p class="hotel-item-value">{{hotelPhone}}</p>
          </div>
          <div class="hotel-item">
            <p class="hotel-item-label">⏰ Check-in</p>
            <p class="hotel-item-value">Từ 14:00</p>
          </div>
          <div class="hotel-item">
            <p class="hotel-item-label">⏰ Check-out</p>
            <p class="hotel-item-value">Trước 12:00</p>
          </div>
        </div>
      </div>

      <!-- Tips -->
      <div class="card">
        <h3>Lưu ý khi đến</h3>
        <div class="tips">
          <div class="tip"><span>🪪</span><span>Mang theo CMND/CCCD hoặc Hộ chiếu để làm thủ tục check-in</span></div>
          <div class="tip"><span>🅿️</span><span>Bãi đỗ xe miễn phí cho khách lưu trú</span></div>
          <div class="tip"><span>📞</span><span>Gọi hotline nếu bạn đến muộn hơn 22:00</span></div>
        </div>
      </div>
    </div>
    <div class="footer">
      <p><strong>{{hotelName}}</strong></p>
      <p>{{hotelAddress}} | ☎ {{hotelPhone}}</p>
      <p>© {{currentYear}} {{hotelName}}. All rights reserved.</p>
    </div>
  </div>
</div>
</body>
</html>